{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go mod:*)",
      "Bash(go version)",
      "Bash(golangci-lint run:*)",
      "Bash(sqlc:*)",
      "Bash(npm run:*)",
      "Bash(npx svelte-check:*)",
      "Bash(npx tsc:*)",
      "Bash(npx playwright:*)",
      "Bash(docker compose:*)",
      "Bash(docker restart:*)",
      "Bash(git push:*)",
      "Bash(grep:*)",
      "Bash(sort:*)",
      "Bash(echo:*)",
      "mcp__playwright"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_git.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/sync_main.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/sync_main.sh\" --on-prompt",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
