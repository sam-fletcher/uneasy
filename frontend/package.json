    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/node": "25.5.2",
    "svelte": "5.57.3",
    "svelte-check": "4.4.6",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
